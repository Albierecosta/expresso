<div class="bg-white rounded-2xl shadow-xl p-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-6">Redefinir senha</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
        html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password,
            autofocus: true, autocomplete: "new-password", required: true,
            class: "form-field" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation,
            autocomplete: "new-password", required: true,
            class: "form-field" %>
    </div>

    <%= f.submit "Alterar senha", class: "btn-primary w-full justify-center" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
