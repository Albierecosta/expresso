<div class="bg-white rounded-2xl shadow-xl p-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-6">Entrar na sua conta</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email,
            autofocus: true, autocomplete: "email", required: true,
            class: "form-field" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password,
            autocomplete: "current-password", required: true,
            class: "form-field" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= f.check_box :remember_me, class: "rounded border-gray-300 text-brand-500 focus:ring-brand-500" %>
        <%= f.label :remember_me, class: "cursor-pointer" %>
      </label>
    <% end %>

    <%= f.submit "Entrar", class: "btn-primary w-full justify-center" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
