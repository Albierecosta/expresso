<%= render "shared/page_header", title: @freight.code, subtitle: @freight.recipient.name do %>
  <%= link_to t("actions.edit"), edit_admin_freight_path(@freight), class: "btn-secondary" %>
  <%= button_to t("actions.destroy"), admin_freight_path(@freight),
        method: :delete,
        form: { data: { turbo_confirm: t("actions.confirm") + "?" } },
        class: "btn-danger" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 card space-y-4">
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:client) %></div>
        <div class="mt-1"><%= @freight.client.name %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:recipient) %></div>
        <div class="mt-1"><%= @freight.recipient.name %></div>
      </div>
      <div class="col-span-2">
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Address.model_name.human %></div>
        <div class="mt-1"><%= @freight.address %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:amount) %></div>
        <div class="mt-1 text-lg font-medium"><%= brl(@freight.amount) %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:order_number) %></div>
        <div class="mt-1"><%= @freight.order_number.presence || "—" %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:status) %></div>
        <div class="mt-1"><%= render "shared/status_badge", value: @freight.status %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:driver) %></div>
        <div class="mt-1"><%= @freight.driver&.name || "—" %></div>
      </div>
      <% if @freight.notes.present? %>
        <div class="col-span-2">
          <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:notes) %></div>
          <div class="mt-1 whitespace-pre-line"><%= @freight.notes %></div>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "qr_panel", freight: @freight %>
</div>
