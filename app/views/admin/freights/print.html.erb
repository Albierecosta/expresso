<div class="text-center mb-6">
  <h1 class="text-xl font-bold"><%= t("app.name") %></h1>
  <p class="text-sm text-gray-500">Etiqueta de Frete</p>
</div>

<div class="border-2 border-gray-900 rounded-md p-6 text-center">
  <%= qr_code_svg(public_delivery_url(@freight.public_token), module_size: 9) %>

  <div class="mt-4 text-xs uppercase tracking-wider text-gray-500">Código do Frete</div>
  <div class="mt-1 font-mono text-2xl"><%= @freight.code %></div>
</div>

<div class="grid grid-cols-2 gap-4 mt-6 text-sm">
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:recipient) %></div>
    <div class="mt-1 font-medium"><%= @freight.recipient.name %></div>
  </div>
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:client) %></div>
    <div class="mt-1"><%= @freight.client.name %></div>
  </div>
  <div class="col-span-2">
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Address.model_name.human %></div>
    <div class="mt-1"><%= @freight.address %></div>
  </div>
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:amount) %></div>
    <div class="mt-1 font-medium"><%= brl(@freight.amount) %></div>
  </div>
  <% if @freight.order_number.present? %>
    <div>
      <div class="text-xs uppercase tracking-wider text-gray-500"><%= Freight.human_attribute_name(:order_number) %></div>
      <div class="mt-1"><%= @freight.order_number %></div>
    </div>
  <% end %>
</div>

<p class="mt-8 text-center text-xs text-gray-500 no-print">
  Esta janela imprime automaticamente. Se não imprimir, use Ctrl+P.
</p>
