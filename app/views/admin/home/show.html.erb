<%= render "shared/page_header",
      title: t("menu.dashboard"),
      subtitle: t("app.tagline") %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <% [
       { label: "Pendentes",   value: 0, tone: "amber" },
       { label: "Em trânsito", value: 0, tone: "blue" },
       { label: "Entregues",   value: 0, tone: "emerald" },
       { label: "Cancelados",  value: 0, tone: "red" }
     ].each do |stat| %>
    <div class="card">
      <div class="text-xs uppercase tracking-wider text-gray-500"><%= stat[:label] %></div>
      <div class="mt-2 text-3xl font-semibold text-gray-900"><%= stat[:value] %></div>
    </div>
  <% end %>
</div>

<%= render "shared/empty_state",
      title: "Nenhum frete ainda",
      subtitle: "Cadastre o primeiro frete para começar a usar o sistema." %>
