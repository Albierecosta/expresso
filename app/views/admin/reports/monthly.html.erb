<%= render "shared/page_header",
      title: t("reports.monthly_title"),
      subtitle: t("reports.monthly_subtitle") do %>
  <%= link_to t("reports.download_pdf"),
        monthly_pdf_admin_reports_path(client_id: @client&.id, date: @date),
        target: "_blank", rel: "noopener", class: "btn-primary" %>
<% end %>

<%= form_with url: monthly_admin_reports_path, method: :get,
      data: { turbo: false }, class: "card mb-6" do %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        <%= Client.model_name.human %>
      </label>
      <%= select_tag :client_id,
            options_from_collection_for_select(@clients, :id, :name, @client&.id),
            include_blank: "Todos os clientes", class: "form-field" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Mês</label>
      <%= date_field_tag :date, @date.strftime("%Y-%m-%d"),
            class: "form-field" %>
    </div>
    <div>
      <%= submit_tag t("actions.search"), class: "btn-primary w-full" %>
    </div>
  </div>
<% end %>

<% if @client %>
  <div class="card mb-4">
    <div class="flex items-center justify-between">
      <div>
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= Client.model_name.human %></div>
        <div class="font-medium"><%= @client.name %></div>
      </div>
      <div class="text-right">
        <div class="text-xs uppercase tracking-wider text-gray-500"><%= t("reports.period") %></div>
        <div class="font-medium">
          <%= l(@date.beginning_of_month, format: :short) %> até
          <%= l(@date.end_of_month, format: :short) %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% if @freights.any? %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-4 py-3">Data</th>
          <th class="px-4 py-3"><%= Freight.human_attribute_name(:code) %></th>
          <th class="px-4 py-3"><%= Freight.human_attribute_name(:recipient) %></th>
          <th class="px-4 py-3 text-right"><%= Freight.human_attribute_name(:amount) %></th>
          <th class="px-4 py-3"><%= t("delivery.signature") %></th>
          <th class="px-4 py-3"><%= t("delivery.photo") %></th>
        </tr>
      </thead>
      <tbody>
        <% @freights.each do |f| %>
          <% delivery = f.delivery %>
          <tr class="border-b border-gray-100">
            <td class="px-4 py-3 text-sm"><%= l(delivery&.delivered_at&.to_date || f.created_at.to_date, format: :short) %></td>
            <td class="px-4 py-3 font-mono text-sm"><%= link_to f.code, admin_freight_path(f), class: "hover:text-brand-600" %></td>
            <td class="px-4 py-3 text-sm"><%= f.recipient.name %></td>
            <td class="px-4 py-3 text-sm text-right"><%= brl(f.amount) %></td>
            <td class="px-4 py-3 text-sm italic">
              <%= delivery&.recipient_name %>
            </td>
            <td class="px-4 py-3">
              <% if delivery&.photo&.attached? %>
                <%= image_tag url_for(delivery.photo),
                      alt: "Foto",
                      class: "w-12 h-12 object-cover rounded" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <tr class="bg-gray-50 font-semibold">
          <td colspan="3" class="px-4 py-3"><%= t("reports.total") %></td>
          <td class="px-4 py-3 text-right text-emerald-600"><%= brl(@total) %></td>
          <td colspan="2"></td>
        </tr>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: t("reports.empty_title"),
        subtitle: t("reports.empty_subtitle") %>
<% end %>
