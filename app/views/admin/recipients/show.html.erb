<%= render "shared/page_header", title: @recipient.name, subtitle: @recipient.client.name do %>
  <%= link_to t("actions.edit"), edit_admin_recipient_path(@recipient), class: "btn-secondary" %>
  <%= button_to t("actions.destroy"), admin_recipient_path(@recipient),
        method: :delete,
        form: { data: { turbo_confirm: t("actions.confirm") + "?" } },
        class: "btn-danger" %>
<% end %>

<div class="card space-y-3 text-sm">
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Recipient.human_attribute_name(:client) %></div>
    <div class="mt-1"><%= link_to @recipient.client.name, admin_client_path(@recipient.client), class: "text-brand-600 hover:underline" %></div>
  </div>
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Recipient.human_attribute_name(:document) %></div>
    <div class="mt-1"><%= @recipient.document.presence || "—" %></div>
  </div>
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Recipient.human_attribute_name(:email) %></div>
    <div class="mt-1"><%= @recipient.email.presence || "—" %></div>
  </div>
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Recipient.human_attribute_name(:phone) %></div>
    <div class="mt-1"><%= @recipient.phone.presence || "—" %></div>
  </div>
  <div>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= Address.model_name.human %></div>
    <div class="mt-1"><%= @recipient.address %></div>
  </div>
</div>
