<%= simple_form_for [ :admin, recipient ], html: { class: "card space-y-6" } do |f| %>
  <%= render "shared/form_errors", record: recipient %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= f.association :client,
          collection: Client.order(:name),
          include_blank: false,
          input_html: { class: "form-field" } %>
    <%= f.input :name,     input_html: { class: "form-field" } %>
    <%= f.input :document, input_html: { class: "form-field" } %>
    <%= f.input :email,    input_html: { class: "form-field" } %>
    <%= f.input :phone,    input_html: { class: "form-field" } %>
  </div>

  <fieldset class="border-t border-gray-100 pt-4">
    <legend class="text-xs uppercase tracking-wider text-gray-500 mb-3">
      <%= Address.model_name.human %>
    </legend>
    <%= f.simple_fields_for :address do |a| %>
      <%= render "addresses/fields", f: a %>
    <% end %>
  </fieldset>

  <div class="flex items-center justify-end gap-2 pt-4 border-t border-gray-100">
    <%= link_to t("actions.cancel"), admin_recipients_path, class: "btn-secondary" %>
    <%= f.submit t("actions.save"), class: "btn-primary" %>
  </div>
<% end %>
