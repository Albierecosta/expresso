<%# Empty state — used by every index when the collection is empty.
     Usage: render "shared/empty_state", title: "...", subtitle: "...", action: link %>
<div class="text-center py-16 px-6 bg-white rounded-lg border border-gray-200">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
       stroke-linecap="round" stroke-linejoin="round"
       class="mx-auto h-12 w-12 text-gray-300">
    <path d="M9 13h6m-3-3v6m9-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
  </svg>
  <h3 class="mt-3 text-sm font-medium text-gray-900"><%= title %></h3>
  <% if local_assigns[:subtitle].present? %>
    <p class="mt-1 text-sm text-gray-500"><%= subtitle %></p>
  <% end %>
  <% if local_assigns[:action].present? %>
    <div class="mt-4"><%= action %></div>
  <% end %>
</div>
